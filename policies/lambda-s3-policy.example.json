{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInputMp4",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/input/*"
    },
    {
      "Sid": "WriteHlsOutput",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/output/*"
    }
  ]
}
